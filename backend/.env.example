# Only for running Python directly from backend/.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=requestflow
POSTGRES_USER=requestflow
POSTGRES_PASSWORD=requestflow_local_only
# Railway supplies this through a PostgreSQL service reference. When set, it takes
# precedence over the individual POSTGRES_* fields above.
# DATABASE_URL=postgresql://user:password@host:5432/requestflow
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Deployment alias accepted by the same setting:
# CORS_ALLOWED_ORIGINS=["https://your-project.vercel.app"]
JWT_SECRET=replace-with-a-generated-secret-of-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development
# One deployment only when initializing a public synthetic demo; remove afterward.
# INITIALIZE_DEMO=true


